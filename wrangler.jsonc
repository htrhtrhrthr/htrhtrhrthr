{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "funbox-beyblade-radar",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",

  "triggers": {
    "crons": ["* * * * *"]
  },

  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  }
}
