{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "funbox-beyblade-radar",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",

  "triggers": {
    "crons": ["* * * * *"]
  },

  "kv_namespaces": [
    {
      "binding": "STOCK_KV",
      "id": "315a3c0cec82461da7f1827ab973a4d6"
    }
  ],

  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  }
}
